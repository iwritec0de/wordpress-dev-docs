{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "960px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#1d4ed8", "name": "Primary" },
				{ "slug": "secondary", "color": "#9333ea", "name": "Secondary" },
				{ "slug": "foreground", "color": "#1f2937", "name": "Foreground" },
				{ "slug": "background", "color": "#ffffff", "name": "Background" },
				{ "slug": "muted", "color": "#6b7280", "name": "Muted" },
				{ "slug": "surface", "color": "#f9fafb", "name": "Surface" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "Inter, system-ui, -apple-system, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "Lexend, system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": [ "rem", "px", "em", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "0.375rem"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
