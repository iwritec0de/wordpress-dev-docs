{
  "name": "@iwritec0de/wpdocs",
  "version": "1.0.0",
  "description": "CLI documentation generator for WordPress plugins and themes",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "wpdocs": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "packages/site-template/template",
    "packages/site-template/skins"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.tsx",
    "dev:watch": "tsx watch src/cli/index.tsx",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "install:global": "pnpm build && pnpm pack --pack-destination /tmp && npm install -g $(ls -t /tmp/iwritec0de-wpdocs-*.tgz | head -1)",
    "uninstall:global": "npm uninstall -g @iwritec0de/wpdocs"
  },
  "keywords": [
    "wordpress",
    "documentation",
    "docs-generator",
    "cli",
    "phpdoc",
    "jsdoc",
    "hooks",
    "filters",
    "rest-api",
    "block-theme",
    "static-site",
    "nextjs",
    "typescript"
  ],
  "author": "Chris Kelley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwritec0de/wordpress-dev-docs.git"
  },
  "bugs": {
    "url": "https://github.com/iwritec0de/wordpress-dev-docs/issues"
  },
  "homepage": "https://github.com/iwritec0de/wordpress-dev-docs#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "ink": "^7.0.0",
    "meow": "^14.1.0",
    "php-parser": "^3.5.1",
    "postcss": "^8.5.9",
    "react": "^19.2.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
